# Copy this file to .env and fill in real values.
# .env is gitignored -- never commit real credentials.

# Which environment tests run against by default: dev | test
TEST_ENV=dev

# Base URLs per environment
DEV_BASE_URL=https://dev.portal.retinalogik.ca
TEST_BASE_URL=https://test.portal.retinalogik.ca

# --- Credentials, per role ---
# clinicUser: has access to the clinic "ClinicUser_Management_Test"
CLINIC_USER_EMAIL=
CLINIC_USER_PASSWORD=

# Add more roles here as they're needed, e.g.:
# CLINIC_ADMIN_EMAIL=
# CLINIC_ADMIN_PASSWORD=
